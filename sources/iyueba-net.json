{
  "schemaVersion": 1,
  "id": "iyueba-net",
  "name": "爱阅吧网",
  "kind": "public-web",
  "version": "1.0.4",
  "baseUrl": "https://iyueba.net/",
  "domains": [
    "iyueba.net",
    "qcdn.zhangzhongyun.com"
  ],
  "script": "scripts/iyueba-net.js",
  "enabled": true,
  "description": "普通小说网页源；GET 搜索入口待修复，详情页已验证提供 og:image，解析器可从封面 CDN 提取真实封面。 封面规则补全：搜索列表读取站点真实图片属性，详情页读取已配置的 og:image 或封面图片；不伪造无封面站点的图片。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创的声明式 GET/CSS 适配配置与解析器，不复制第三方脚本或小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/iyueba-net.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://iyueba.net/z/?keyword={keyword}",
    "bookUrl": "https://iyueba.net/{bookUrl}",
    "chapterListUrl": "https://iyueba.net/{bookUrl}",
    "chapterUrl": "https://iyueba.net/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".item",
        "titleSelector": "a:nth-of-type(2)",
        "urlSelector": "a:nth-of-type(2)",
        "coverSelector": "img"
      },
      "detail": {
        "titleSelector": "h1",
        "coverSelector": "meta[property='og:image']",
        "coverAttribute": "content"
      },
      "chapters": {
        "itemSelector": "#content_1 dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#booktxt",
        "titleSelector": "h1"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
