{
  "schemaVersion": 1,
  "id": "kuaishu5-com",
  "name": "快书网",
  "kind": "public-web",
  "version": "1.0.0",
  "baseUrl": "https://www.kuaishu5.com/",
  "domains": [
    "www.kuaishu5.com"
  ],
  "script": "scripts/kuaishu5-com.js",
  "enabled": true,
  "testOnly": true,
  "testOnlyReason": "已从公开上游规则转换为本仓库原创 GET/CSS 适配；站点搜索曾有间歇性失灵，尚未完成当前宿主四阶段实测。",
  "description": "普通小说源；GET 搜索，详情、目录与正文采用 CSS 规则。搜索稳定性需后续复测。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创的声明式适配配置与解析器，不复制第三方脚本或小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/kuaishu5-com.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.kuaishu5.com/search/?searchkey={keyword}",
    "bookUrl": "https://www.kuaishu5.com/{bookUrl}",
    "chapterListUrl": "https://www.kuaishu5.com/{bookUrl}",
    "chapterUrl": "https://www.kuaishu5.com/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".item",
        "titleSelector": "h3 a",
        "urlSelector": "h3 a",
        "authorSelector": "p:nth-of-type(2) a"
      },
      "detail": {
        "titleSelector": "h1"
      },
      "chapters": {
        "itemSelector": "#content_1 a",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#booktxt",
        "titleSelector": "h1"
      }
    }
  }
}
