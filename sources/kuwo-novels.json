{
  "schemaVersion": 1,
  "id": "kuwo-novels",
  "name": "酷我小说（开放接口）",
  "kind": "public-web",
  "version": "1.0.1",
  "description": "酷我小说公开 GET JSON 接口适配器；App 已增加 book_id→详情 URL、chapter_id→章节 URL 映射，使用显式 {bookId}/{chapterId} 模板；仍需 App 原生环境验证接口返回字段与正文可读性。",
  "baseUrl": "https://appi.kuwo.cn/",
  "domains": [
    "appi.kuwo.cn",
    "openbookcover.yuewen.com"
  ],
  "script": "scripts/kuwo-novels.js",
  "enabled": true,
  "categories": [
    "男频",
    "女频"
  ],
  "appConfig": {
    "searchUrl": "https://appi.kuwo.cn/novels/api/book/search?keyword={keyword}&pi={page}&ps=30",
    "bookUrl": "https://appi.kuwo.cn/novels/api/book/{bookId}",
    "chapterListUrl": "https://appi.kuwo.cn/novels/api/book/{bookId}/chapters?paging=0",
    "chapterUrl": "https://appi.kuwo.cn/novels/api/book/{bookId}/chapters/{chapterId}"
  },
  "hostValidated": false,
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库中的书源适配器、字段映射和请求解析代码由项目维护者在本仓库独立编写；不包含小说正文，也不主张拥有或授权目标网站收录的作品。该声明仅覆盖本仓库适配代码。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/scripts/kuwo-novels.js",
  "validationStatus": "imported-unverified",
  "validationNote": "API ID 映射已纳入 App 开发分支回归测试；真实接口详情、目录和正文请求仍待 App 原生网络环境复测。"
}
