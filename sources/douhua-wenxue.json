{
  "schemaVersion": 1,
  "id": "douhua-wenxue",
  "name": "豆花文学",
  "kind": "public-web",
  "version": "1.0.4",
  "baseUrl": "https://www.douhuawenxue.com/",
  "domains": [
    "www.douhuawenxue.com",
    "img.douhuawenxue.com",
    "imgold2.douhuawenxue.com"
  ],
  "script": "scripts/douhua-wenxue.js",
  "enabled": true,
  "description": "原创小说站网页源；GET 搜索，详情、目录和正文采用 CSS 规则。站点近期仍有更新内容；部分作品可能存在付费章节，当前宿主四阶段复测待完成。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创的声明式 GET/CSS 适配配置与解析器，不复制第三方脚本或小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/douhua-wenxue.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.douhuawenxue.com/search?kd={keyword}",
    "bookUrl": "https://www.douhuawenxue.com/{bookUrl}",
    "chapterListUrl": "https://www.douhuawenxue.com/{bookUrl}",
    "chapterUrl": "https://www.douhuawenxue.com/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".book-base",
        "titleSelector": "h3 a",
        "urlSelector": "h3 a",
        "authorSelector": ".book_author",
        "descriptionSelector": ".book_ct",
        "coverSelector": "img.book_img"
      },
      "detail": {
        "titleSelector": "h1"
      },
      "chapters": {
        "itemSelector": ".list-inline-3 .list_item",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#J_chapterContent",
        "titleSelector": "h1"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
