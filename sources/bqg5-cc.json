{
  "schemaVersion": 1,
  "id": "bqg5-cc",
  "name": "笔趣阁②",
  "kind": "public-web",
  "version": "1.0.0",
  "baseUrl": "https://www.bqg5.cc/",
  "domains": [
    "www.bqg5.cc"
  ],
  "script": "scripts/bqg5-cc.js",
  "enabled": true,
  "testOnly": true,
  "testOnlyReason": "从公开书源集合的 GET/HTTPS 规则转换为本仓库 CSS 四阶段配置；未采用上游脚本规则。当前站点实时访问及目标宿主四阶段尚未完成实测。",
  "description": "普通小说网页源；已转换为 GET 搜索、详情、目录和正文 CSS 规则，待目标宿主实测。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/bqg5-cc.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.bqg5.cc//modules/article/search.php?searchkey={keyword}",
    "bookUrl": "https://www.bqg5.cc/{bookUrl}",
    "chapterListUrl": "https://www.bqg5.cc/{bookUrl}",
    "chapterUrl": "https://www.bqg5.cc/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".grid tr",
        "titleSelector": "td.odd a",
        "urlSelector": "td.odd a"
      },
      "detail": {
        "titleSelector": "#info h1",
        "descriptionSelector": "#intro p"
      },
      "chapters": {
        "itemSelector": "#list dd:nth-child(n+10)",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#content",
        "titleSelector": "h1"
      }
    }
  }
}
