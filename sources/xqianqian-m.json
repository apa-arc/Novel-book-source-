{
  "schemaVersion": 1,
  "id": "xqianqian-m",
  "name": "千千小说",
  "kind": "public-web",
  "version": "1.0.3",
  "baseUrl": "https://m.xqianqian.com/",
  "domains": [
    "m.xqianqian.com",
    "www.xqianqian.com"
  ],
  "script": "scripts/xqianqian-m.js",
  "enabled": true,
  "description": "普通小说网页源；详情页已验证提供 og:image，脚本补充真实封面提取。当前搜索入口 /s.php?q=关键词 会跳回首页，搜索功能待修复。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创的声明式 GET/CSS 适配配置与解析器，不复制第三方脚本或小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/xqianqian-m.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://m.xqianqian.com/s.php?q={keyword}",
    "bookUrl": "https://m.xqianqian.com/{bookUrl}",
    "chapterListUrl": "https://m.xqianqian.com/{bookUrl}",
    "chapterUrl": "https://m.xqianqian.com/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".bookbox",
        "titleSelector": ".bookname a",
        "urlSelector": ".bookname a",
        "authorSelector": ".author",
        "coverSelector": "img"
      },
      "detail": {
        "titleSelector": ".name",
        "descriptionSelector": ".book_about dd"
      },
      "chapters": {
        "itemSelector": ".book_last dl dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#chaptercontent",
        "titleSelector": "h1"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
