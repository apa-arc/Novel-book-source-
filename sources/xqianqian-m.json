{
  "schemaVersion": 1,
  "id": "xqianqian-m",
  "name": "千千小说",
  "kind": "public-web",
  "version": "1.0.4",
  "baseUrl": "https://www.xqianqian.com/",
  "domains": [
    "www.xqianqian.com"
  ],
  "script": "scripts/xqianqian-m.js",
  "enabled": true,
  "description": "普通小说网页源；已修复搜索入口，搜索结果封面从图片懒加载 data-original 提取真实图片地址。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创的声明式 GET/CSS 适配配置与解析器，不复制第三方脚本或小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/xqianqian-m.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.xqianqian.com/search/?searchkey={keyword}",
    "bookUrl": "https://www.xqianqian.com/{bookUrl}",
    "chapterListUrl": "https://www.xqianqian.com/{bookUrl}",
    "chapterUrl": "https://www.xqianqian.com/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".category-div",
        "titleSelector": ".commend-title h3",
        "urlSelector": ".category-div > a",
        "authorSelector": ".commend-title span",
        "coverSelector": "img",
        "coverAttribute": "data-original"
      },
      "detail": {
        "titleSelector": ".name",
        "descriptionSelector": ".book_about dd"
      },
      "chapters": {
        "itemSelector": ".book_last dl dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#chaptercontent",
        "titleSelector": "h1"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
