{
  "schemaVersion": 1,
  "id": "dingdian-23uswx",
  "name": "顶点小说",
  "kind": "public-web",
  "version": "1.0.0",
  "baseUrl": "https://www.23uswx.net/",
  "domains": [
    "www.23uswx.net"
  ],
  "script": "scripts/dingdian-23uswx.js",
  "enabled": true,
  "testOnly": true,
  "testOnlyReason": "从公开上游 GET 搜索规则转换；已补齐本项目四阶段 CSS 配置，尚未完成当前站点实时与宿主实测。",
  "description": "普通小说网页源；已转换为 GET + CSS 四阶段配置，待实测。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库自行编写的声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/dingdian-23uswx.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.23uswx.net/modules/article/search.php?q={keyword}",
    "bookUrl": "https://www.23uswx.net/",
    "chapterListUrl": "https://www.23uswx.net/{bookUrl}",
    "chapterUrl": "https://www.23uswx.net/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".grid tr",
        "titleSelector": "td:nth-child(1) a",
        "urlSelector": "td:nth-child(1) a",
        "authorSelector": "td:nth-child(3)"
      },
      "detail": {
        "titleSelector": "#info h1",
        "descriptionSelector": "#intro"
      },
      "chapters": {
        "itemSelector": "#list dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#content",
        "titleSelector": "h1"
      }
    }
  }
}
