{
  "schemaVersion": 1,
  "id": "yushufang-ysfwxc",
  "name": "御书房",
  "kind": "public-web",
  "version": "1.0.0",
  "baseUrl": "https://www.ysfwxc.com/",
  "domains": [
    "www.ysfwxc.com"
  ],
  "script": "scripts/yushufang-ysfwxc.js",
  "enabled": true,
  "testOnly": true,
  "testOnlyReason": "由公开上游小说源规则转换为本仓库 GET/CSS 配置；已映射搜索、详情、目录、正文，尚未完成当前站点实时与宿主四阶段实测。",
  "description": "普通小说网页源；GET 搜索，详情、目录与正文采用 CSS 规则，待实测。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/yushufang-ysfwxc.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.ysfwxc.com/search/?searchkey={keyword}",
    "bookUrl": "https://www.ysfwxc.com/",
    "chapterListUrl": "https://www.ysfwxc.com/{bookUrl}",
    "chapterUrl": "https://www.ysfwxc.com/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".book_data",
        "titleSelector": "h1 a",
        "urlSelector": "h1 a",
        "authorSelector": ".author span"
      },
      "detail": {
        "titleSelector": "h1",
        "descriptionSelector": "meta[property='og:description']"
      },
      "chapters": {
        "itemSelector": ".con dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": ".content",
        "titleSelector": "h1"
      }
    }
  }
}
