{
  "schemaVersion": 1,
  "id": "biquges123-web",
  "name": "新笔趣阁（biquges123）",
  "kind": "public-web",
  "version": "1.0.1",
  "description": "从清阅开源项目验证的新笔趣阁网页源；搜索结果封面使用真实 CDN 图片地址，支持详情、目录和正文。 封面规则补全：搜索列表读取站点真实图片属性，详情页读取已配置的 og:image 或封面图片；不伪造无封面站点的图片。 当前状态：已导入，待 App 真机完整验证；不代表已验证可读。",
  "baseUrl": "https://www.biquges123.com/",
  "domains": [
    "www.biquges123.com",
    "cdn.biquge7.top"
  ],
  "script": "scripts/biquges123-web.js",
  "enabled": true,
  "categories": [
    "男频",
    "女频"
  ],
  "appConfig": {
    "searchUrl": "https://www.biquges123.com/search?keyword={keyword}&page={page}",
    "bookUrl": "https://www.biquges123.com/{bookUrl}",
    "chapterListUrl": "https://www.biquges123.com/{bookUrl}",
    "chapterUrl": "https://www.biquges123.com/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".hot_4_item",
        "titleSelector": ".hot_name",
        "urlSelector": "a",
        "urlAttribute": "href",
        "authorSelector": ".author",
        "descriptionSelector": ".hot_des",
        "coverSelector": "img",
        "coverAttribute": "src"
      },
      "detail": {
        "titleSelector": "h1.info_title",
        "authorSelector": ".info_ct > div:nth-child(2)",
        "descriptionSelector": ".des",
        "coverSelector": "img",
        "coverAttribute": "src"
      },
      "chapters": {
        "itemSelector": ".list li",
        "titleSelector": "a",
        "urlSelector": "a",
        "urlAttribute": "href"
      },
      "content": {
        "contentSelector": "article.article",
        "titleSelector": "h1"
      }
    }
  },
  "hostValidated": false,
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库中的书源适配器、字段映射和请求解析代码由项目维护者在本仓库独立编写；不包含小说正文，也不主张拥有或授权目标网站收录的作品。该声明仅覆盖本仓库适配代码。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/scripts/biquges123-web.js",
  "validationStatus": "imported-unverified",
  "validationNote": "已通过静态 HTTPS 域名白名单、App 原生配置结构和解析器接口检查；尚未取得完整 iOS App 真机搜索、详情、目录、正文四阶段通过报告。"
}
