{
  "schemaVersion": 1,
  "id": "xinbiquge-info",
  "name": "新笔趣阁小说网",
  "kind": "public-web",
  "version": "1.0.9",
  "baseUrl": "https://www.xbiquge.info/",
  "domains": [
    "www.xbiquge.info"
  ],
  "script": "scripts/xinbiquge-info.js",
  "enabled": true,
  "description": "普通小说网页源；GET 搜索，目录分页，正文使用 article.font_max。2026-11-26 按实时搜索页结构修复列表卡片选择器：dl / h3 / a / img；详情封面使用 og:image。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/xinbiquge-info.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.xbiquge.info/search.php?q={keyword}",
    "bookUrl": "https://www.xbiquge.info/{bookUrl}",
    "chapterListUrl": "https://www.xbiquge.info/{bookUrl}",
    "chapterUrl": "https://www.xbiquge.info/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": "dl",
        "titleSelector": "h3",
        "urlSelector": "a",
        "authorSelector": "dd:nth-of-type(2)",
        "coverSelector": "img",
        "coverAttribute": "src"
      },
      "detail": {
        "titleSelector": "h1",
        "descriptionSelector": "#intro",
        "coverSelector": "meta[property='og:image']",
        "coverAttribute": "content"
      },
      "chapters": {
        "itemSelector": ".book_list2 > ul > li",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "article.font_max",
        "titleSelector": "h1"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
