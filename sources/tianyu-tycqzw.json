{
  "schemaVersion": 1,
  "id": "tianyu-tycqzw",
  "name": "天域小说网",
  "kind": "public-web",
  "version": "1.0.0",
  "baseUrl": "https://www.tycqzw.la/",
  "domains": [
    "www.tycqzw.la"
  ],
  "script": "scripts/tianyu-tycqzw.js",
  "enabled": true,
  "testOnly": true,
  "testOnlyReason": "从公开上游 GET 搜索规则转换；已将详情、目录、正文映射为 CSS 规则，尚未完成当前站点实时与宿主实测。",
  "description": "普通小说网页源；已转换为 GET + CSS 四阶段配置，待实测。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库自行编写的声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/tianyu-tycqzw.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.tycqzw.la/search.php?searchkey={keyword}",
    "bookUrl": "https://www.tycqzw.la/",
    "chapterListUrl": "https://www.tycqzw.la/{bookUrl}",
    "chapterUrl": "https://www.tycqzw.la/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".grid tr",
        "titleSelector": "td.even a",
        "urlSelector": "td.even a",
        "authorSelector": "td.odd"
      },
      "detail": {
        "titleSelector": "#info h1",
        "descriptionSelector": "#intro"
      },
      "chapters": {
        "itemSelector": "#list dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#content",
        "titleSelector": "h1"
      }
    }
  }
}
