{
  "schemaVersion": 1,
  "id": "d8zw-com",
  "name": "第八中文网",
  "kind": "public-web",
  "version": "1.0.5",
  "baseUrl": "https://www.d8zw.com/",
  "domains": [
    "www.d8zw.com"
  ],
  "script": "scripts/d8zw-com.js",
  "enabled": true,
  "description": "普通小说网页源；GET 搜索，目录使用 CSS 选择器，正文使用 article.font_max。上游规则注明偶发 502，需控制请求频率。 2026-11-22 修复：目录请求改为直接读取书籍详情页，避免 index_1.html 返回404；等待复测。 2026-11-25 修复：详情页封面改从已验证的 og:image 元数据提取。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/d8zw-com.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.d8zw.com/search.php?q={keyword}",
    "bookUrl": "https://www.d8zw.com/{bookUrl}",
    "chapterListUrl": "https://www.d8zw.com/{bookUrl}",
    "chapterUrl": "https://www.d8zw.com/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".box.hot dl",
        "titleSelector": "dd h3 a",
        "urlSelector": "dd h3 a",
        "authorSelector": "dd.book_other span",
        "coverSelector": "dt img"
      },
      "detail": {
        "titleSelector": "h1",
        "descriptionSelector": "#intro"
      },
      "chapters": {
        "itemSelector": ".book_list2 > ul > li",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "article.font_max",
        "titleSelector": "h1"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
