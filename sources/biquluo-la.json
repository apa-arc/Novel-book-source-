{
  "schemaVersion": 1,
  "id": "biquluo-la",
  "name": "壁落小说",
  "kind": "public-web",
  "version": "1.0.6",
  "baseUrl": "https://www.biquluo.la/",
  "domains": [
    "www.biquluo.la"
  ],
  "script": "scripts/biquluo-la.js",
  "enabled": true,
  "description": "普通小说网页源；GET 搜索、书籍详情、章节目录与正文。搜索列表页当前不提供封面图片节点，详情页通过已配置的 og:image 提取封面；搜索列表缺图需由 App 侧封面补全机制兜底。",
  "licenseApproved": true,
  "licenseType": "open-license",
  "licenseEvidence": "解析规则基于 luanmuc/legado-book-sources 仓库中的 MIT License 来源规则适配；此许可仅覆盖规则代码的再分发，不代表目标网站对其收录小说内容作出授权。",
  "licenseEvidenceUrl": "https://github.com/luanmuc/legado-book-sources/blob/main/LICENSE",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.biquluo.la/search.html?name={keyword}",
    "bookUrl": "https://www.biquluo.la/",
    "chapterListUrl": "https://www.biquluo.la/{bookUrl}",
    "chapterUrl": "https://www.biquluo.la/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".novelslist2 li",
        "titleSelector": ".s2 a",
        "urlSelector": ".s2 a",
        "authorSelector": ".s4",
        "coverSelector": "img"
      },
      "detail": {
        "titleSelector": "#info h1",
        "descriptionSelector": "#intro",
        "coverSelector": "meta[property='og:image']",
        "coverAttribute": "content"
      },
      "chapters": {
        "itemSelector": "#list dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#content",
        "titleSelector": "h1"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
