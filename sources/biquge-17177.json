{
  "schemaVersion": 1,
  "id": "biquge-17177",
  "name": "笔趣阁小说网（17177）",
  "kind": "public-web",
  "version": "1.0.5",
  "baseUrl": "https://www.17177.cc/",
  "domains": [
    "www.17177.cc"
  ],
  "script": "scripts/biquge-17177.js",
  "enabled": true,
  "description": "普通小说网页源；GET 搜索，详情页元信息、目录与正文使用 CSS 提取。 2026-11-25 修复：详情页封面改从已验证的 og:image 元数据提取。 2026-11-25 修复：搜索结果封面明确读取 img 的 src 属性。 封面规则补全：搜索列表读取站点真实图片属性，详情页读取已配置的 og:image 或封面图片；不伪造无封面站点的图片。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/biquge-17177.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.17177.cc/search.php?q={keyword}&p={page}",
    "bookUrl": "https://www.17177.cc/{bookUrl}",
    "chapterListUrl": "https://www.17177.cc/{bookUrl}",
    "chapterUrl": "https://www.17177.cc/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".hot dl",
        "titleSelector": "h3 a",
        "urlSelector": "h3 a",
        "authorSelector": ".book_other span",
        "coverSelector": "dt img",
        "coverAttribute": "src"
      },
      "detail": {
        "titleSelector": "meta[property='og:novel:book_name']",
        "authorSelector": "meta[property='og:novel:author']",
        "descriptionSelector": "meta[property='og:description']",
        "coverSelector": "meta[property='og:image']",
        "coverAttribute": "content"
      },
      "chapters": {
        "itemSelector": ".book_list2 li",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": ".single article",
        "titleSelector": "h1"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
