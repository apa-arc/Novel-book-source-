{
  "schemaVersion": 1,
  "id": "wujixsw-info",
  "name": "无极小说",
  "kind": "public-web",
  "version": "1.0.0",
  "baseUrl": "https://wujixsw.info/",
  "domains": [
    "wujixsw.info"
  ],
  "script": "scripts/wujixsw-info.js",
  "enabled": true,
  "testOnly": true,
  "testOnlyReason": "由公开上游小说源规则转换为本仓库 GET/CSS 配置；已映射搜索、详情、目录、正文，尚未完成当前站点实时与宿主四阶段实测。",
  "description": "普通小说网页源；GET 搜索，详情、目录与正文采用 CSS 规则，待实测。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/wujixsw-info.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://wujixsw.info/search.html?name={keyword}",
    "bookUrl": "https://wujixsw.info/",
    "chapterListUrl": "https://wujixsw.info/{bookUrl}",
    "chapterUrl": "https://wujixsw.info/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".novelslist2 li",
        "titleSelector": ".s2 a",
        "urlSelector": ".s2 a",
        "authorSelector": ".s4"
      },
      "detail": {
        "titleSelector": "h1",
        "descriptionSelector": "meta[property='og:description']"
      },
      "chapters": {
        "itemSelector": "#list dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#content",
        "titleSelector": "h1"
      }
    }
  }
}
