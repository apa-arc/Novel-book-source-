{
  "schemaVersion": 1,
  "id": "bqg-info",
  "name": "笔趣阁info",
  "kind": "public-web",
  "version": "1.0.6",
  "baseUrl": "https://www.bqg.info/",
  "domains": [
    "www.bqg.info"
  ],
  "script": "scripts/bqg-info.js",
  "enabled": true,
  "description": "普通小说网页源；GET 搜索，书籍详情页内含章节目录，正文使用 #booktxt。2026-11-25 修复：搜索结果封面从 a.thumbnail 的 background-image 提取；站点 og:image 会错误重复拼接域名。2026-11-26 补全脚本详情页 img.img-thumbnail[src] 封面字段，避免脚本运行时漏掉详情封面。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库原创声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/bqg-info.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.bqg.info/search/?searchkey={keyword}",
    "bookUrl": "https://www.bqg.info/{bookUrl}",
    "chapterListUrl": "https://www.bqg.info/{bookUrl}",
    "chapterUrl": "https://www.bqg.info/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": "div.book-coverlist",
        "titleSelector": "h4 a",
        "urlSelector": "h4 a",
        "coverSelector": "a.thumbnail",
        "coverAttribute": "style"
      },
      "detail": {
        "titleSelector": "h1",
        "descriptionSelector": "#bookIntro",
        "coverSelector": "img.img-thumbnail",
        "coverAttribute": "src"
      },
      "chapters": {
        "itemSelector": "dl#newlist > dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#booktxt",
        "titleSelector": "h1.readTitle"
      }
    }
  },
  "userConfirmedExistingSource": true,
  "userConfirmedWorkingAt": "2026-11-21"
}
