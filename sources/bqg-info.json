{
  "schemaVersion": 1,
  "id": "bqg-info",
  "name": "笔趣阁info（第三方）",
  "kind": "public-web",
  "version": "0.1.0",
  "description": "第三方公开网页小说候选源；支持书名搜索、详情、目录与章节正文解析。内容权属未经核验，仅记录解析规则，不复制正文。",
  "baseUrl": "https://www.bqg.info/",
  "domains": [
    "www.bqg.info"
  ],
  "script": "scripts/bqg-info.js",
  "enabled": false,
  "categories": [
    "网络小说",
    "玄幻",
    "仙侠",
    "都市",
    "历史",
    "网游",
    "科幻",
    "悬疑",
    "言情"
  ],
  "licenseNote": "第三方转载站点，站点声明内容来自互联网或网友上传并仅供个人阅读；内容授权未核验。当前为待验证候选，不进入正式订阅。",
  "appConfig": {
    "searchUrl": "https://www.bqg.info/search/?searchkey={keyword}",
    "bookUrl": "https://www.bqg.info/book/{bookId}/",
    "chapterListUrl": "https://www.bqg.info/book/{bookId}/",
    "chapterUrl": "https://www.bqg.info/read/{bookId}/{chapterId}.html",
    "htmlRules": {
      "search": {
        "itemSelector": "div.book-coverlist",
        "titleSelector": "h4 a",
        "urlSelector": "h4 a",
        "descriptionSelector": "div.caption p",
        "urlAttribute": "href"
      },
      "detail": {
        "titleSelector": "meta[property='og:novel:book_name']",
        "authorSelector": "meta[property='og:novel:author']",
        "descriptionSelector": "#bookIntro"
      },
      "chapters": {
        "itemSelector": "dl#newlist > dd",
        "titleSelector": "a",
        "urlSelector": "a",
        "urlAttribute": "href"
      },
      "content": {
        "titleSelector": "h1.readTitle",
        "contentSelector": "#booktxt"
      }
    }
  }
}
