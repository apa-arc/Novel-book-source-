{
  "schemaVersion": 1,
  "id": "deqi-novel",
  "name": "得奇小说（App适配候选）",
  "kind": "public-web",
  "version": "0.1.0",
  "description": "基于得奇小说网页结构建立的 AppleNovelApp 适配候选；搜索、详情、目录、正文选择器尚待目标 App 真机验证。",
  "baseUrl": "https://www.deqitxt.com/",
  "domains": [
    "www.deqitxt.com"
  ],
  "script": "scripts/deqi-novel.js",
  "enabled": false,
  "categories": [
    "网络小说"
  ],
  "licenseNote": "第三方网页来源；当前未取得或核验规则再分发许可，保持禁用，不进入正式订阅。",
  "appConfig": {
    "searchUrl": "https://www.deqitxt.com/so/so.aspx?key={keyword}",
    "bookUrl": "https://www.deqitxt.com/{bookId}/",
    "chapterListUrl": "https://www.deqitxt.com/{bookId}/",
    "chapterUrl": "https://www.deqitxt.com/{chapterId}",
    "htmlRules": {
      "search": {
        "itemSelector": ".item",
        "titleSelector": "h3 a",
        "urlSelector": "h3 a",
        "authorSelector": "p:nth-of-type(2) a",
        "descriptionSelector": ".des",
        "urlAttribute": "href",
        "coverSelector": "img",
        "coverAttribute": "src"
      },
      "detail": {
        "titleSelector": "h1 a",
        "authorSelector": "p:nth-of-type(2) a",
        "descriptionSelector": ".des"
      },
      "chapters": {
        "itemSelector": "#list li",
        "titleSelector": "a",
        "urlSelector": "a",
        "urlAttribute": "href"
      },
      "content": {
        "titleSelector": "h1",
        "contentSelector": ".con"
      }
    }
  }
}
