{
  "schemaVersion": 1,
  "id": "novel-demo-source",
  "name": "原创联调书源（星海来信）",
  "kind": "public-web",
  "version": "1.0.0",
  "description": "本仓库原创短篇测试源，提供真实 HTTPS 静态页面，可用于验证搜索、详情、目录和正文读取。",
  "baseUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/demo-content/",
  "domains": [
    "raw.githubusercontent.com"
  ],
  "script": "scripts/novel-demo-source.js",
  "enabled": true,
  "categories": [
    "原创测试",
    "科幻"
  ],
  "licenseNote": "原创测试内容由本项目为阅读器联调生成，不复制第三方小说内容；仅用于本仓库与兼容阅读器的功能验证。",
  "licenseType": "self-owned",
  "licenseApproved": true,
  "licenseEvidence": "《星海来信》及其三章正文为本项目原创联调文本，随书源仓库一并发布；页面与解析规则均由本项目维护。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/tree/main/demo-content",
  "hostValidated": true,
  "appConfig": {
    "searchUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/demo-content/search.html",
    "bookUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/demo-content/book.html",
    "chapterListUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/demo-content/chapters.html",
    "chapterUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/demo-content/chapter-1.html",
    "htmlRules": {
      "search": {
        "itemSelector": ".book",
        "titleSelector": ".title",
        "urlSelector": ".title",
        "authorSelector": ".author",
        "descriptionSelector": ".intro",
        "urlAttribute": "href"
      },
      "detail": {
        "titleSelector": ".title",
        "authorSelector": ".author",
        "descriptionSelector": ".intro"
      },
      "chapters": {
        "itemSelector": ".chapter",
        "titleSelector": "a",
        "urlSelector": "a",
        "urlAttribute": "href"
      },
      "content": {
        "contentSelector": "#content",
        "titleSelector": ".title"
      }
    }
  },
  "qualityReport": "quality-reports/novel-demo-source.json",
  "functionalTestReport": "quality-reports/novel-demo-source-functional.json"
}
