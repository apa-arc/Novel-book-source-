{
  "schemaVersion": 1,
  "id": "wuxian-wenxuesk",
  "name": "无限小说",
  "kind": "public-web",
  "version": "1.0.0",
  "baseUrl": "https://www.wenxuesk.net/",
  "domains": [
    "www.wenxuesk.net"
  ],
  "script": "scripts/wuxian-wenxuesk.js",
  "enabled": true,
  "testOnly": true,
  "testOnlyReason": "从公开上游 GET 搜索规则转换；目录的原始 XPath 已改写为 CSS 规则，尚未完成当前站点实时与宿主实测。",
  "description": "普通小说网页源；已转换为 GET + CSS 四阶段配置，待实测。",
  "licenseApproved": true,
  "licenseType": "self-owned",
  "licenseEvidence": "本仓库自行编写的声明式适配配置与解析器，不包含小说正文。",
  "licenseEvidenceUrl": "https://github.com/apa-arc/Novel-book-source-/blob/main/sources/wuxian-wenxuesk.json",
  "hostValidated": false,
  "appConfig": {
    "searchUrl": "https://www.wenxuesk.net/search/result.html?searchkey={keyword}",
    "bookUrl": "https://www.wenxuesk.net/",
    "chapterListUrl": "https://www.wenxuesk.net/{bookUrl}",
    "chapterUrl": "https://www.wenxuesk.net/{chapterUrl}",
    "htmlRules": {
      "search": {
        "itemSelector": ".search-list li",
        "titleSelector": ".s2 a",
        "urlSelector": ".s2 a",
        "authorSelector": ".s4"
      },
      "detail": {
        "titleSelector": "h1",
        "descriptionSelector": "#intro"
      },
      "chapters": {
        "itemSelector": "#list dd",
        "titleSelector": "a",
        "urlSelector": "a"
      },
      "content": {
        "contentSelector": "#content",
        "titleSelector": "h1"
      }
    }
  }
}
