{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apa-arc.github.io/Novel-book-source-/schemas/source.schema.json",
  "title": "Apple Novel Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "kind",
    "version",
    "baseUrl",
    "domains",
    "script",
    "enabled"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kind": {
      "enum": [
        "official",
        "public-web"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "script": {
      "type": "string",
      "pattern": "^scripts/[a-z0-9-]+\\.js$"
    },
    "enabled": {
      "type": "boolean"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "licenseNote": {
      "type": "string",
      "maxLength": 500
    },
    "appConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searchUrl",
        "bookUrl",
        "chapterListUrl",
        "chapterUrl"
      ],
      "properties": {
        "searchUrl": {
          "type": "string",
          "minLength": 1
        },
        "bookUrl": {
          "type": "string",
          "minLength": 1
        },
        "chapterListUrl": {
          "type": "string",
          "minLength": 1
        },
        "chapterUrl": {
          "type": "string",
          "minLength": 1
        },
        "htmlRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "search": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemSelector",
                "titleSelector",
                "urlSelector"
              ],
              "properties": {
                "itemSelector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "titleSelector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "urlSelector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "authorSelector": {
                  "type": "string",
                  "maxLength": 300
                },
                "descriptionSelector": {
                  "type": "string",
                  "maxLength": 300
                },
                "urlAttribute": {
                  "type": "string",
                  "maxLength": 40
                },
                "coverSelector": {
                  "type": "string",
                  "maxLength": 300
                },
                "coverAttribute": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            },
            "detail": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "titleSelector": {
                  "type": "string",
                  "maxLength": 300
                },
                "authorSelector": {
                  "type": "string",
                  "maxLength": 300
                },
                "descriptionSelector": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "chapters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemSelector",
                "titleSelector",
                "urlSelector"
              ],
              "properties": {
                "itemSelector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "titleSelector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "urlSelector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "urlAttribute": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            },
            "content": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contentSelector"
              ],
              "properties": {
                "contentSelector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "titleSelector": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "licenseType": {
      "type": "string",
      "enum": [
        "self-owned",
        "written-permission",
        "open-license",
        "public-domain"
      ]
    },
    "licenseEvidenceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "licenseApproved": {
      "type": "boolean"
    },
    "licenseEvidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "hostValidated": {
      "type": "boolean"
    },
    "qualityReport": {
      "type": "string",
      "pattern": "^quality-reports/[a-z0-9-]+\\.json$"
    },
    "functionalTestReport": {
      "type": "string",
      "pattern": "^quality-reports/[a-z0-9-]+-functional\\.json$"
    }
  }
}
