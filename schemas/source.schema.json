{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apa-arc.github.io/Novel-book-source-/schemas/source.schema.json",
  "title": "Apple Novel Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "kind", "version", "baseUrl", "domains", "script", "enabled"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "kind": { "enum": ["official", "public-web"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "maxLength": 300 },
    "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "script": { "type": "string", "pattern": "^scripts/[a-z0-9-]+\\.js$" },
    "enabled": { "type": "boolean" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "licenseNote": { "type": "string", "maxLength": 500 }
  }
}
