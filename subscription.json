      "scriptUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/scripts/biquluo-la.js",
      "appConfig": {
        "searchUrl": "https://www.biquluo.la/search.html?name={keyword}",
        "bookUrl": "https://www.biquluo.la/",
        "chapterListUrl": "https://www.biquluo.la/{bookUrl}",
        "chapterUrl": "https://www.biquluo.la/{chapterUrl}",
        "htmlRules": {
          "search": {
            "itemSelector": ".novelslist2 li",
            "titleSelector": ".s2 a",
            "urlSelector": ".s2 a",
            "authorSelector": ".s4"
          },
          "detail": {
            "titleSelector": "#info h1",
            "descriptionSelector": "#intro"
          },
          "chapters": {
            "itemSelector": "#list dd",
            "titleSelector": "a",
            "urlSelector": "a"
          },
          "content": {
            "contentSelector": "#content",
            "titleSelector": "h1"
          }
        }
      },
      "testOnly": true,
      "testOnlyReason": "旧版 Legado 四阶段联网测试曾通过；当前先开放给 AppleNovelApp 原生宿主联调，尚未完成 App 侧复测。"
    },
