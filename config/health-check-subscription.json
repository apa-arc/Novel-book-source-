    {
      "id": "biquges123-web",
      "name": "新笔趣阁（biquges123）",
      "kind": "public-web",
      "version": "1.0.1",
      "description": "从清阅开源项目验证的新笔趣阁网页源；搜索结果封面使用真实 CDN 图片地址，支持详情、目录和正文。 封面规则补全：搜索列表读取站点真实图片属性，详情页读取已配置的 og:image 或封面图片；不伪造无封面站点的图片。",
      "baseUrl": "https://www.biquges123.com/",
      "domains": [
        "www.biquges123.com",
        "cdn.biquge7.top"
      ],
      "categories": [
        "男频",
        "女频"
      ],
      "metadataUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/sources/biquges123-web.json",
      "scriptUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/scripts/biquges123-web.js",
      "appConfig": {
        "searchUrl": "https://www.biquges123.com/search?keyword={keyword}&page={page}",
        "bookUrl": "https://www.biquges123.com/{bookUrl}",
        "chapterListUrl": "https://www.biquges123.com/{bookUrl}",
        "chapterUrl": "https://www.biquges123.com/{chapterUrl}",
        "htmlRules": {
          "search": {
            "itemSelector": ".hot_4_item",
            "titleSelector": ".hot_name",
            "urlSelector": "a",
            "urlAttribute": "href",
            "authorSelector": ".author",
            "descriptionSelector": ".hot_des",
            "coverSelector": "img",
            "coverAttribute": "src"
          },
          "detail": {
            "titleSelector": "h1.info_title",
            "authorSelector": ".info_ct > div:nth-child(2)",
            "descriptionSelector": ".des",
            "coverSelector": "img",
            "coverAttribute": "src"
          },
          "chapters": {
            "itemSelector": ".list li",
            "titleSelector": "a",
            "urlSelector": "a",
            "urlAttribute": "href"
          },
          "content": {
            "contentSelector": "article.article",
            "titleSelector": "h1"
          }
        }
      }
    },
    {
      "id": "kuwo-novels",
      "name": "酷我小说（开放接口）",
      "kind": "public-web",
      "version": "1.0.0",
      "description": "依据清阅开源项目验证的酷我小说 GET JSON 接口；搜索、详情、章节、正文及阅文封面 CDN 均已实测。",
      "baseUrl": "https://appi.kuwo.cn/",
      "domains": [
        "appi.kuwo.cn",
        "openbookcover.yuewen.com"
      ],
      "categories": [
        "男频",
        "女频"
      ],
      "metadataUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/sources/kuwo-novels.json",
      "scriptUrl": "https://raw.githubusercontent.com/apa-arc/Novel-book-source-/main/scripts/kuwo-novels.js",
      "appConfig": {
        "searchUrl": "https://appi.kuwo.cn/novels/api/book/search?keyword={keyword}&pi={page}&ps=30",
        "bookUrl": "https://appi.kuwo.cn/novels/api/book/{bookUrl}",
        "chapterListUrl": "https://appi.kuwo.cn/novels/api/book/{bookUrl}/chapters?paging=0",
        "chapterUrl": "https://appi.kuwo.cn/novels/api/book/{bookUrl}/chapters/{chapterUrl}"
      }
