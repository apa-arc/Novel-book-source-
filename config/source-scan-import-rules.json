        "http429": {
          "maxAttempts": 3,
          "delaySeconds": [
            8,
            16
          ],
          "reason": "rate limit needs longer exponential cooldown"
        },
        "crossDomainRedirect": {
          "maxAttempts": 2,
          "delaySeconds": [
            5
          ],
          "reason": "confirm redirect behavior once; never treat as source failure"
        },
        "transientNetwork": {
          "maxAttempts": 3,
          "delaySeconds": [
            4,
            8
          ],
          "reason": "allow transport/DNS/timeouts to recover"
        },
        "http5xx": {
          "maxAttempts": 3,
          "delaySeconds": [
            4,
            8
          ],
          "reason": "allow upstream server recovery"
        },
        "parseErrors": {
          "maxAttempts": 3,
          "delaySeconds": [
            2.5,
            5
          ],
          "reason": "confirm deterministic parser/response failures"
        }
      }
    },
    "bothKeywordsMustHaveSuccessfulRequests": true,
